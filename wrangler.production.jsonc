{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clarkcant-blog",
  "account_id": "009dc0fcd0da3e503fbf38eb2b586e4b",
  "main": "dist/server/entry.mjs",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{"type":"ESModule","globs":["**/*.js","**/*.mjs"]}],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory":"dist/client","binding":"ASSETS"},
  "d1_databases": [{"binding":"DB","database_name":"clarkcant-blog","database_id":"652ad588-5be3-4879-bf7c-e9c6e964f4b6","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"clarkcant-blog-media"}],
  "vars": {"SITE_URL":"https://clarkcant.cc","OWNER_GITHUB_ID":"6857382"},
  "routes": [
    {"pattern":"clarkcant.cc/blog*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/vi/blog*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/assets/blog/*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/api/blog/*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/mcp*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/auth/*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/oauth/*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/.well-known/oauth*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/media/*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/openapi.json*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/llms*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/robots.txt*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/sitemap.xml*","zone_name":"clarkcant.cc"},
    {"pattern":"clarkcant.cc/site-sitemap.xml*","zone_name":"clarkcant.cc"}
  ]
}
